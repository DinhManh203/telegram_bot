# Telegram Bot Token (Lấy từ @BotFather trên Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (Lấy miễn phí từ https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Đường dẫn tới file Google Service Account JSON (chạy local)
GOOGLE_CREDENTIALS_FILE=credentials.json

# HOẶC Paste toàn bộ nội dung file JSON vào đây (khi Deploy lên Railway/Cloud)
GOOGLE_CREDENTIALS_JSON=

# Tên bảng tính Google Sheet (Bot sẽ tự mở file này hoặc bạn tạo trước)
# HOẶC ID của bảng tính (dãy ký tự trong URL giữa /d/ và /edit)
SPREADSHEET_ID_OR_NAME=Chi Tieu Ca Nhan

# Timezone (Mặc định: Asia/Ho_Chi_Minh)
TIMEZONE=Asia/Ho_Chi_Minh

# (Tùy chọn) Danh sách Telegram User ID được phép dùng bot (cách nhau bởi dấu phẩy, để trống nếu cho phép tất cả)
# Ví dụ: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=
